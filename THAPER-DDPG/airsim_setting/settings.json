{
  "SeeDocsAt": "https://github.com/microsoft/AirSim/blob/main/docs/settings.md",
  "SettingsVersion": 1.2,
  "ApiControlMode": true,
  "SimMode": "Multirotor",
  "ApiControlTimeout": 10.0,
  "AllowAPIAlways": true,
  "RpcLibPort": 41451,
  "EnableSyncMode": true,
  "WaitOnStart": true,
  "ResetOnCollision": true,
  "ClockSpeed": 1.0,
