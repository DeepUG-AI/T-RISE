          "X": 0, "Y": 0, "Z": -0.8,
          "Roll": 0, "Pitch": 0, "Yaw": 0,
          "HorizontalFOVStart": -150,
          "HorizontalFOVEnd": 150,
          "VerticalFOVUpper": 40,
          "VerticalFOVLower": -40,
          "PointCloudFormat": "XYZ",
          "DataFrame": "SensorLocalFrame",
          "DrawDebugPoints": true  
        }
      },
      "X": 0, "Y": 0, "Z": 0,
      "Yaw": 0
    },
    "Drone2": {
